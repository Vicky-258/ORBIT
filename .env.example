# =============================================================================
# AADS (Agentic Architecture Design & Simulation) Environment Configuration
# =============================================================================

# LLM Provider Configuration (Optional)
# AADS supports live LLM extraction & synthesis as well as 100% offline deterministic execution.
# If no API key is provided, AADS runs seamlessly in DETERMINISTIC FALLBACK mode.

# Groq (Default fast inference provider)
GROQ_API_KEY=""

# OpenAI (Alternative provider)
OPENAI_API_KEY=""

# Anthropic (Alternative provider)
ANTHROPIC_API_KEY=""

# Execution & Investigation Bounds
AADS_MAX_INVESTIGATION_ROUNDS="3"
AADS_INVESTIGATION_BUDGET_SECONDS="60.0"

# Service Host & Port Defaults
AADS_API_HOST="0.0.0.0"
AADS_API_PORT="8000"
AADS_UI_PORT="8501"
