# =============================================================================
# ORBIT (Orchestrated Reasoning and Benchmarking for Infrastructure Testing) Environment Configuration
# =============================================================================

# LLM Provider Configuration (Optional)
# ORBIT supports live LLM extraction & synthesis as well as 100% offline deterministic execution.
# If no API key is provided, ORBIT runs seamlessly in DETERMINISTIC FALLBACK mode.

# Groq (Default fast inference provider)
GROQ_API_KEY=""

# OpenAI (Alternative provider)
OPENAI_API_KEY=""

# Anthropic (Alternative provider)
ANTHROPIC_API_KEY=""

# Execution & Investigation Bounds
ORBIT_MAX_INVESTIGATION_ROUNDS="3"
ORBIT_INVESTIGATION_BUDGET_SECONDS="60.0"

# Service Host & Port Defaults
ORBIT_API_HOST="0.0.0.0"
ORBIT_API_PORT="8000"
ORBIT_UI_PORT="8501"
